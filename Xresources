! Terminal colors
! (I moved away from RXVT due to an issue with the cursor shape in tmux + nvim)
URxvt*background: #1B1B1B
URxvt*foreground: #cccccc
URxvt*scrollBar: false
URxvt*letterSpace: -2
URxvt*font: xft:DejaVu Sans Mono:size=9
*color0:  #2E3436
*color1:  #a40000
*color2:  #4E9A06
*color3:  #C4A000
*color4:  #3465A4
*color5:  #75507B
*color6:  #ce5c00
*color7:  #babdb9
*color8:  #555753
*color9:  #EF2929
*color10: #8AE234
*color11: #FCE94F
*color12: #729FCF
*color13: #AD7FA8
*color14: #fcaf3e
*color15: #EEEEEC

! XTerm settings
XTerm*locale: true
XTerm*metaSendsEscape: true
XTerm*saveLines: 4096
XTerm*background: #1B1B1B
XTerm*foreground: #cccccc
! XTerm*faceName: DejaVu Sans Mono:size=9
XTerm*faceName: Fira Code:size=11
XTerm*selectToClipboard: true


! Fonts
Xft.dpi:                96
Xft.antialias:          true
Xft.hintstyle: hintslight
Xft.lcdfilter: lcddefault
Xft.autohint: 0
Xft.hinting:  1
Xft.rgba: rgb

#include "rofi/Xresources"
