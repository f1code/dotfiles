! Terminal colors
URxvt*background: #1B1B1B
URxvt*foreground: #cccccc
URxvt*scrollBar: false
*color0:  #2E3436
*color1:  #a40000
*color2:  #4E9A06
*color3:  #C4A000
*color4:  #3465A4
*color5:  #75507B
*color6:  #ce5c00
*color7:  #babdb9
*color8:  #555753
*color9:  #EF2929
*color10: #8AE234
*color11: #FCE94F
*color12: #729FCF
*color13: #AD7FA8
*color14: #fcaf3e
*color15: #EEEEEC

! Fonts
Xft.dpi:                96
Xft.antialias:          true
Xft.hintstyle: hintslight
Xft.lcdfilter: lcddefault
Xft.autohint: 0
Xft.hinting:  1
Xft.rgba: rgb

! ------------------------------------------------------------------------------
! ROFI Color theme
! ------------------------------------------------------------------------------
! Use extended color scheme
rofi.color-enabled:                  true
! Color scheme for normal row: bg, fg, bg alt, hlbg, hlfg
rofi.color-normal:                   #2f343f, #f3f4f5, #2f343f, #2f343f, #9575cd
! Color scheme for urgent row: bg, fg, bg alt, hlbg, hlfg
rofi.color-urgent:                   argb:00000000, #ffa0a0, argb:00000000, #ffa0a0,#0060a0
! Color scheme for active row: bg, fg, bg alt, hlbg, hlfg
rofi.color-active:                   argb:00000000, #a0ffa0, argb:00000000, #a0ffa0,#0060a0
! Color scheme window: bg, border, separator
rofi.color-window:                   #2f343f, #00b0ef, #2f343f
rofi.font:                          Deja Vu Sans 18
rofi.lines: 10
! Full screen breaks transparency with i3, so leave it false, add padding instead
rofi.fullscreen: false
rofi.padding: 400
rofi.opacity: 90
rofi.width: 100
rofi.bw: 0
