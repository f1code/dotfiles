[custom-keybindings/custom0]
binding=['<Shift>Print']
command='shutter -s'
name='Shutter Area'

[/]
looking-glass-keybinding=['<Super>g']
custom-list=['custom0']

[media-keys]
area-screenshot=@as []
terminal=['<Super>t']
screensaver=['<Super>l', 'XF86ScreenSaver']
home=['<Super>e', 'XF86Explorer']
search=['XF86Search', '<Primary><Shift><Alt>s']

[wm]
maximize=['<Super>x']
move-to-workspace-1=['<Shift><Super>exclam']
move-to-workspace-2=['<Shift><Super>at']
move-to-workspace-3=['<Shift><Super>numbersign']
move-to-workspace-4=['<Shift><Super>dollar']
switch-to-workspace-2=['Launch6']
move-to-workspace-right=['<Primary><Shift><Super>Right']
switch-to-workspace-1=['Launch5']
panel-run-dialog=['<Super>r']
switch-to-workspace-4=['Launch8']
move-to-workspace-new=@as []
move-to-workspace-left=['<Primary><Shift><Super>Left']
switch-to-workspace-3=['Launch7']
minimize=['<Super>grave']
