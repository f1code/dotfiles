# Bindings - Application Shortcuts {{{

# start a terminal
bindsym $mod+Return exec i3-sensible-terminal
bindsym $mod+g exec gvim
# Floating terminal
bindsym $mod+t exec urxvt -name urxvt-floaty
# Web browsers - different configs
bindsym XF86HomePage exec --no-startup-id $script-dir/browser-default
bindsym XF86Mail exec --no-startup-id $script-dir/browser-xtivia
bindsym $mod+XF86Mail exec --no-startup-id $script-dir/browser-ilx
# File browser
bindsym XF86Search exec thunar
# Screenshots
#  PrintScreen = Capture to clipboard
bindsym Print exec --no-startup-id $script-dir/screenshot
#  Start+Print = Capture and edit
bindsym $mod+Print exec --no-startup-id $script-dir/screenshot edit
bindsym $mod+Shift+Print exec pinta
bindsym Ctrl+XF86Calculator exec gsimplecal
bindsym XF86Calculator exec urxvt -name python-floaty -e python


