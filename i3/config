# Bindings - Utilities {{{

# kill focused window
bindsym $mod+Shift+q kill
# start dmenu (a program launcher)
#bindsym Shift+Menu exec dmenu_run
# There also is the (new) i3-dmenu-desktop which only displays applications
# shipping a .desktop file. It is a wrapper around dmenu, so you need that
# installed.
# bindsym $mod+d exec --no-startup-id i3-dmenu-desktop
# bindsym Menu exec --no-startup-id i3-dmenu-desktop
# Note configuration for rofi color is in .Xresources
# Rofi regular (desktop entries) menu
bindsym Mod1+F2 exec rofi -show drun 
# Rofi run command
bindsym $mod+F2 exec rofi -show run 
# Rofi RDP connect
bindsym $mod+F3 exec $script-dir/rofi-rdp
bindsym $mod+Tab exec rofi -show window
bindsym $mod+Menu exec i3lock

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Ctrl+Shift+q exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -b 'Yes, exit i3' 'i3-msg exit'"
bindsym $mod+Shift+e exec "gvim ~/.config/i3/config"

# Volume control... need to adjust those for multiple channels though
# TODO; write small app that will check current default sink and adjust corresponding channel
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume 1 +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume 1 -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute 1 toggle
bindsym $mod+XF86AudioMute exec --no-startup-id pactl set-default-sink 0


