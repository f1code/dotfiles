{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["opencode", "opencode-go", "google", "amazon-bedrock"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://llm.4gclinical.com/v1"
      },
      "models": {
        "claude-opus-5": {
          "name": "Opus 5"
        },
        "claude-sonnet-5": {
          "name": "Sonnet 5"
        },
        "claude-haiku-4-5": {
          "name": "Haiku 4.5"
        },
        "claude-fable-5": {
          "name": "Fable 5"
        }
      }
    }
  },
  "agent": {
    "explore": {
      "model": "litellm/claude-haiku-4-5"
    },
    "build": {
      "model": "litellm/claude-opus-5"
    },
    "plan": {
      "model": "litellm/claude-opus-5"
    }
  },
  "tui": {
    "mouse": false
  },
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "aws *": "ask",
      "ssh *": "ask",
      "kubectl *": "ask",
      "pip install *": "deny"
    }
  },
  "lsp": {
    "ty": {
      "command": ["ty", "server"],
      "extensions": [".py"]
    },
    "pyright": {
      "disabled": true
    }
  }
}
